---
/**
 * Ilustração das serras mineiras ao entardecer, com uma casa de campo e um
 * varal de luzes — usada enquanto não houver fotografia oficial. É uma
 * ilustração (não representa o restaurante). As camadas com `data-depth`
 * recebem um leve movimento de paralaxe.
 */
interface Props {
  class?: string;
  /** Prefixo dos ids internos (único por ilustração na página). */
  id?: string;
}

const { class: className, id = 'ls' } = Astro.props;

// Lâmpadas do varal de luzes (catenária entre a casa e o poste).
const bulbs = Array.from({ length: 11 }, (_, i) => {
  const t = (i + 0.5) / 11;
  const x = 1092 + (1262 - 1092) * t;
  const y = 662 + (650 - 662) * t + Math.sin(Math.PI * t) * 26;
  return [Math.round(x), Math.round(y)];
});

const stars = [
  [120, 70, 1.2], [260, 140, 0.9], [410, 50, 1.1], [560, 120, 0.8], [700, 60, 1.2], [860, 110, 0.9],
  [980, 40, 1], [1440, 80, 1.1], [1530, 150, 0.8], [1180, 60, 0.9],
];
---

<svg
  class:list={['landscape', className]}
  viewBox="0 0 1600 900"
  preserveAspectRatio="xMaxYMax slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#18261d"></stop>
      <stop offset=".34" stop-color="#3a3a2b"></stop>
      <stop offset=".58" stop-color="#8a5438"></stop>
      <stop offset=".74" stop-color="#cf8a52"></stop>
      <stop offset=".86" stop-color="#e7b874"></stop>
    </linearGradient>
    <radialGradient id={`${id}-sun-glow`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#f6d79a" stop-opacity=".75"></stop>
      <stop offset=".3" stop-color="#eab46e" stop-opacity=".35"></stop>
      <stop offset="1" stop-color="#c6763f" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id={`${id}-haze`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f1c98a" stop-opacity="0"></stop>
      <stop offset=".55" stop-color="#f1c98a" stop-opacity=".28"></stop>
      <stop offset="1" stop-color="#f1c98a" stop-opacity="0"></stop>
    </linearGradient>
    <radialGradient id={`${id}-window`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ffd98c" stop-opacity=".55"></stop>
      <stop offset="1" stop-color="#ffd98c" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <rect width="1600" height="900" fill={`url(#${id}-sky)`}></rect>

  <g data-depth="0.4">
    {stars.map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#fbf8f2" opacity=".45" />)}
    <circle cx="1300" cy="560" r="330" fill={`url(#${id}-sun-glow)`}></circle>
    <circle class="landscape__sun" cx="1300" cy="560" r="58" fill="#f8dfa6"></circle>
  </g>

  <!-- Serras ao fundo, com névoa dourada -->
  <g data-depth="0.3">
    <path
      d="M0 590 80 560l70 18 96-70 76 34 70-44 104 62 76-26 116 40 92-78 80 48 70-14 108 56 98-66 90 46 82-28 100 50 88-34 114 44V900H0Z"
      fill="#8a5a43"></path>
  </g>
  <rect y="520" width="1600" height="200" fill={`url(#${id}-haze)`}></rect>
  <g data-depth="0.22">
    <path
      d="M0 650c110-36 200-74 330-50s210 56 330 22 220-72 350-42 230 66 340 38 160-46 250-32v314H0Z"
      fill="#5b4a37"></path>
  </g>
  <g data-depth="0.14">
    <path
      d="M0 716c150-42 290-60 430-32s250 42 390 6 270-50 410-18 250 34 370 10v218H0Z"
      fill="#34402f"></path>
    <!-- Araucárias na encosta -->
    <g fill="#2c3829">
      <path d="M232 690v-26l-14 8 14-16-18 6 18-20-12 2 12-16 12 16-12-2 18 20-18-6 14 16-14-8v26Z"></path>
      <path d="M290 684v-20l-11 6 11-12-14 4 14-15-9 1 9-12 9 12-9-1 14 15-14-4 11 12-11-6v20Z"></path>
      <path d="M560 690v-28l-15 9 15-18-19 7 19-22-13 2 13-17 13 17-13-2 19 22-19-7 15 18-15-9v28Z"></path>
    </g>
  </g>

  <!-- Primeiro plano: casa de campo, varal de luzes e árvores -->
  <g data-depth="0.05">
    <path d="M0 800c200-36 380-52 600-26s360 30 560 4 300-28 440-6v128H0Z" fill="#1f2c22"></path>
    <path d="M820 812c120-40 250-80 420-76s280 30 360 46v118H820Z" fill="#1a271d"></path>

    <g transform="translate(160 0)">
      <g class="landscape__house">
        <!-- Fumaça do fogão a lenha -->
        <path
          class="landscape__smoke"
          d="M1106 590c-12-16 10-24-2-42s8-28-4-46"
          fill="none"
          stroke="#f1d7ae"
          stroke-width="7"
          stroke-linecap="round"
          opacity=".22"></path>
        <circle cx="1100" cy="700" r="120" fill={`url(#${id}-window)`}></circle>
        <rect x="1096" y="606" width="20" height="44" fill="#141f17"></rect>
        <path d="M990 676 1068 622l78 54Z" fill="#162219"></path>
        <path d="M1004 674h128v70h-128Z" fill="#1b281e"></path>
        <path d="M986 678 1068 620l82 58" fill="none" stroke="#a65336" stroke-width="4" opacity=".7"></path>
        <rect x="1022" y="692" width="22" height="22" rx="2" fill="#f2c46f"></rect>
        <rect x="1092" y="692" width="22" height="22" rx="2" fill="#f2c46f"></rect>
        <rect x="1056" y="700" width="24" height="44" rx="2" fill="#e9b05c"></rect>
        <path d="M1033 692v22M1022 703h22M1103 692v22M1092 703h22" stroke="#1b281e" stroke-width="2"></path>
        <path d="M1150 678h70v66h-70Z" fill="#162219"></path>
        <path d="M1146 680h80" stroke="#a65336" stroke-width="3" opacity=".6"></path>
        <path d="M1160 744v-50M1210 744v-50" stroke="#2a382d" stroke-width="3"></path>
      </g>

      <path d="M1262 744v-98" stroke="#141f17" stroke-width="4"></path>
      <path
        d="M1092 662Q1177 708 1262 650"
        fill="none"
        stroke="#141f17"
        stroke-width="1.5"></path>
      <g class="landscape__bulbs">
        {bulbs.map(([x, y]) => <circle cx={x} cy={y + 3} r="3.4" fill="#ffd98c" />)}
      </g>
    </g>

    <!-- Árvore frondosa -->
    <g transform="translate(140 0)">
      <path d="M1372 752v-60" stroke="#121c15" stroke-width="10"></path>
      <path
        d="M1372 584c-46 0-76 30-72 66 4 30 34 46 72 46s70-16 74-46c4-36-28-66-74-66Z"
        fill="#141f17"></path>
      <path
        d="M1320 610c-30 6-46 30-40 52s30 30 52 24M1424 604c32 6 50 30 44 54s-32 32-56 24"
        fill="#141f17"></path>
    </g>

    <!-- Cerca -->
    <g stroke="#2b3a2e" stroke-width="3">
      <path d="M860 770h120M860 786h120M870 760v34M900 758v36M930 758v36M960 760v34"></path>
    </g>

    <path d="M0 850c260-24 520-30 800-18s540 10 800-8v76H0Z" fill="#142119"></path>
  </g>
</svg>

<style>
  .landscape {
    width: 100%;
    height: 100%;
  }

  .landscape g[data-depth] {
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    .landscape__sun {
      animation: sun-set 2.6s var(--ease-out) both;
    }

    .landscape__smoke {
      animation: smoke 7s ease-in-out infinite alternate;
    }

    .landscape__bulbs circle {
      animation: glow 3.2s ease-in-out infinite alternate;
    }

    .landscape__bulbs circle:nth-child(3n) {
      animation-delay: -1.4s;
    }

    .landscape__bulbs circle:nth-child(3n + 1) {
      animation-delay: -2.3s;
    }
  }

  @keyframes sun-set {
    from {
      opacity: 0;
      transform: translateY(-36px);
    }
  }

  @keyframes smoke {
    from {
      opacity: 0.12;
      transform: translate(-3px, 4px);
    }
    to {
      opacity: 0.26;
      transform: translate(5px, -6px);
    }
  }

  @keyframes glow {
    from {
      opacity: 0.65;
    }
  }
</style>
