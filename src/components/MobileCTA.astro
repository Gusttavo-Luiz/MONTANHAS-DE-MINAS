---
import Icon from './Icon.astro';
import { mapLinks, whatsappLink } from '../config/site';
---

<nav class="mobile-cta" data-mobile-cta aria-label="Atalhos de contato">
  <a class="btn btn--terracotta" href={mapLinks.directions} target="_blank" rel="noopener">
    <Icon name="route" /> Como chegar<span class="sr-only"> (abre o Google Maps em nova aba)</span>
  </a>
  <a class="btn btn--whatsapp" href={whatsappLink()} target="_blank" rel="noopener">
    <Icon name="whatsapp" /> WhatsApp<span class="sr-only"> (abre em nova aba)</span>
  </a>
</nav>

<style>
  .mobile-cta {
    display: none;
  }

  @media (max-width: 760px) {
    .mobile-cta {
      position: fixed;
      inset: auto 0 0;
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
      padding: 0.7rem var(--gutter) max(0.7rem, env(safe-area-inset-bottom));
      background: rgb(251 248 242 / 0.96);
      box-shadow: 0 -1px 0 var(--line), 0 -12px 30px -18px rgb(43 35 29 / 0.4);
      backdrop-filter: saturate(1.4) blur(12px);
      transform: translateY(110%);
      transition: transform 0.45s var(--ease-out);
    }

    .mobile-cta.is-visible {
      transform: none;
    }

    .mobile-cta .btn {
      min-height: 3rem;
      padding-inline: 0.75rem;
    }

    :global(body:has(.mobile-cta.is-visible) .site-footer) {
      padding-bottom: 5.5rem;
    }
  }
</style>

<script>
  // Aparece depois da primeira dobra e some sobre a seção de contato.
  const bar = document.querySelector<HTMLElement>('[data-mobile-cta]');
  const hero = document.querySelector('#inicio');
  const contact = document.querySelector('#contato');

  if (bar && hero && 'IntersectionObserver' in window) {
    let heroVisible = true;
    let contactVisible = false;
    const sync = () => bar.classList.toggle('is-visible', !heroVisible && !contactVisible);
    new IntersectionObserver(([entry]) => {
      heroVisible = entry.isIntersecting;
      sync();
    }).observe(hero);
    if (contact) {
      new IntersectionObserver(([entry]) => {
        contactVisible = entry.isIntersecting;
        sync();
      }).observe(contact);
    }
  }
</script>
