---
import Icon from './Icon.astro';
import Landscape from './Landscape.astro';
import { site, whatsappLink, phoneLink } from '../config/site';
---

<section class="contact on-dark" id="contato" aria-labelledby="contact-title">
  <div class="contact__art" aria-hidden="true">
    <Landscape id="ls-contact" />
  </div>
  <div class="container contact__inner">
    <p class="eyebrow" data-reveal>Contato e WhatsApp</p>
    <h2 class="display contact__title" id="contact-title" data-reveal style="--reveal-delay:100">
      Vamos preparar seu <em>próximo momento especial?</em>
    </h2>
    <p class="lead contact__text" data-reveal style="--reveal-delay:180">
      Quer tirar dúvidas, confirmar os horários ou saber mais sobre nossa experiência gastronômica? Entre em contato
      com o Montanhas de Minas.
    </p>
    <div class="contact__actions" data-reveal style="--reveal-delay:260">
      <a class="btn btn--whatsapp btn--lg contact__whatsapp" href={whatsappLink()} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={22} /> Conversar no WhatsApp<span class="sr-only"> (abre em nova aba)</span>
      </a>
      <a class="btn btn--ghost-light btn--lg" href={phoneLink}>
        <Icon name="phone" /> {site.contact.phoneDisplay}
      </a>
    </div>
    <p class="note contact__note" data-reveal style="--reveal-delay:320">
      Atendimento por WhatsApp e telefone. O site não faz reservas nem pedidos on-line.
    </p>
  </div>
</section>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(5rem, 3.5rem + 8vw, 10rem) clamp(7rem, 5rem + 10vw, 13rem);
    background: var(--green-night);
    color: var(--on-dark);
    text-align: center;
  }

  .contact__art {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .contact__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(20 33 25 / 0.82), rgb(20 33 25 / 0.55) 55%, rgb(20 33 25 / 0.2));
  }

  .contact__art :global(.landscape) {
    position: absolute;
    inset: 0;
  }

  .contact__inner {
    display: grid;
    justify-items: center;
  }

  .contact__title {
    max-width: 18ch;
    margin-top: 1.1rem;
  }

  .contact__title em {
    color: var(--gold-light);
  }

  .contact__text {
    max-width: 38rem;
    margin-top: 1.5rem;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2.5rem;
  }

  .contact__whatsapp {
    box-shadow: 0 12px 30px -10px rgb(31 122 77 / 0.7);
  }

  .contact__note {
    margin-top: 1.5rem;
  }

  @media (max-width: 600px) {
    .contact__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
