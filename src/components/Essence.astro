---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import type { IconName } from './icons';
import { featuredPhotos } from '../content/photos';

const pillars: { icon: IconName; title: string; text: string }[] = [
  { icon: 'utensils', title: 'Sabor e tradição', text: 'Referências da culinária mineira e brasileira.' },
  { icon: 'heart', title: 'Ambiente acolhedor', text: 'Um espaço para reunir pessoas e criar boas lembranças.' },
  { icon: 'leaf', title: 'Clima de interior', text: 'Tranquilidade, natureza e uma experiência longe da correria urbana.' },
];
---

<section class="essence section" id="nossa-historia" aria-labelledby="essence-title">
  <div class="container essence__grid">
    <div class="essence__text">
      <p class="eyebrow" data-reveal>Nossa essência</p>
      <h2 class="display essence__title" id="essence-title" data-reveal style="--reveal-delay:100">
        Mais que uma refeição, <em>uma experiência mineira.</em>
      </h2>
      <p class="lead essence__lead" data-reveal style="--reveal-delay:180">
        Em meio à tranquilidade da zona rural de Itaúna, o Restaurante Montanhas de Minas reúne o melhor da culinária
        brasileira com o acolhimento característico de Minas Gerais.
      </p>
      <p class="essence__body" data-reveal style="--reveal-delay:240">
        Um espaço para reunir a família, encontrar os amigos e aproveitar cada momento ao redor da mesa — um lugar para
        desacelerar e apreciar boa comida sem pressa.
      </p>

      <ul class="pillars">
        {
          pillars.map((pillar, i) => (
            <li class="pillar" data-reveal style={`--reveal-delay:${120 + i * 90}`}>
              <span class="pillar__icon">
                <Icon name={pillar.icon} size={22} />
              </span>
              <span>
                <h3 class="pillar__title">{pillar.title}</h3>
                <p class="pillar__text">{pillar.text}</p>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="essence__media" data-reveal style="--reveal-delay:120">
      <div class="essence__photo">
        <Photo {...featuredPhotos.essence} tone="green" sizes="(min-width: 960px) 44vw, 100vw" widths={[520, 820, 1200]} />
      </div>
      <div class="essence__detail">
        <Photo
          {...featuredPhotos.essenceDetail}
          tone="terracotta"
          hint={false}
          sizes="(min-width: 960px) 18vw, 40vw"
          widths={[300, 520]}
        />
      </div>
      <p class="essence__stamp" aria-hidden="true">
        <span>Itaúna</span>
        <span class="essence__stamp-mark">✦</span>
        <span>Minas Gerais</span>
      </p>
    </div>
  </div>
</section>

<style>
  .essence__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(3rem, 2rem + 5vw, 7rem);
    align-items: center;
  }

  .essence__title {
    margin-top: 1.1rem;
    max-width: 15ch;
  }

  .essence__title em {
    color: var(--terracotta);
  }

  .essence__lead {
    margin-top: 1.75rem;
    max-width: 36rem;
  }

  .essence__body {
    margin-top: 1rem;
    max-width: 36rem;
    color: var(--ink-soft);
  }

  .pillars {
    display: grid;
    gap: 0;
    margin-top: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .pillar {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: start;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--line);
  }

  .pillar__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--cream);
    color: var(--terracotta);
    transition:
      background-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }

  .pillar:hover .pillar__icon {
    background: var(--terracotta);
    color: var(--on-dark);
  }

  .pillar__title {
    font-size: 1.3rem;
    color: var(--green);
  }

  .pillar__text {
    margin-top: 0.2rem;
    color: var(--ink-soft);
    font-size: 0.9688rem;
  }

  .essence__media {
    position: relative;
    padding: 0 0 clamp(3rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem);
  }

  .essence__photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
  }

  .essence__photo :global(img),
  .essence__photo :global(picture),
  .essence__photo :global(.photo-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .essence__detail {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 44%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 6px solid var(--cream-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }

  .essence__detail :global(img),
  .essence__detail :global(picture),
  .essence__detail :global(.photo-placeholder) {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
  }

  .essence__stamp {
    position: absolute;
    top: 1.5rem;
    right: -0.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: var(--gold);
    color: var(--green-night);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    box-shadow: var(--shadow-soft);
  }

  .essence__stamp-mark {
    font-size: 0.75rem;
    letter-spacing: 0;
  }

  @media (max-width: 960px) {
    .essence__grid {
      grid-template-columns: 1fr;
    }

    .essence__media {
      max-width: 36rem;
      width: 100%;
      margin-inline: auto;
    }

    .essence__stamp {
      right: 0.75rem;
    }
  }
</style>
