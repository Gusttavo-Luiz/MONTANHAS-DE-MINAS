---
import Icon from './Icon.astro';
import { openingHours, hoursNotice } from '../content/hours';
import { formatRange } from '../lib/hours';
import { whatsappLink } from '../config/site';
---

<section class="hours section" id="horarios" aria-labelledby="hours-title">
  <div class="container hours__grid">
    <div class="hours__intro">
      <p class="eyebrow" data-reveal>Horários de funcionamento</p>
      <h2 class="display hours__title" id="hours-title" data-reveal style="--reveal-delay:100">
        Planeje <em>sua visita.</em>
      </h2>
      <p class="hours__status" data-hours-status hidden aria-live="polite">
        <span class="hours__dot" aria-hidden="true"></span>
        <span data-hours-status-text></span>
      </p>
      <p class="hours__notice" data-reveal style="--reveal-delay:180">
        <Icon name="info" size={20} />
        <span>{hoursNotice}</span>
      </p>
      <a
        class="link-arrow hours__link"
        href={whatsappLink('Olá! Conheci o Restaurante Montanhas de Minas pelo site e gostaria de confirmar o horário de funcionamento.')}
        target="_blank"
        rel="noopener"
        data-reveal
        style="--reveal-delay:240"
      >
        Confirmar horário pelo WhatsApp <Icon name="arrowRight" /><span class="sr-only"> (abre em nova aba)</span>
      </a>
    </div>

    <div class="hours__card" data-reveal style="--reveal-delay:120">
      <p class="hours__card-title">
        <Icon name="clock" size={22} />
        Horário habitual
      </p>
      <dl class="hours__list">
        {
          openingHours.map((day) => (
            <div class:list={['hours__row', { 'hours__row--closed': !day.open }]} data-weekday={day.weekday}>
              <dt>
                {day.label}
                <span class="hours__today">Hoje</span>
              </dt>
              <dd>{formatRange(day)}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .hours {
    background: var(--cream);
  }

  .hours__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 2rem + 5vw, 7rem);
    align-items: center;
  }

  .hours__title {
    margin-top: 1.1rem;
  }

  .hours__title em {
    color: var(--terracotta);
  }

  .hours__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    background: var(--cream-light);
    border: 1px solid var(--line-strong);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
  }

  .hours__status[hidden] {
    display: none;
  }

  .hours__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--ink-soft);
  }

  .hours__status.is-open .hours__dot {
    background: #2f8a57;
    box-shadow: 0 0 0 4px rgb(47 138 87 / 0.18);
  }

  .hours__notice {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    max-width: 30rem;
    margin-top: 1.75rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .hours__notice :global(.icon) {
    flex: none;
    margin-top: 0.15rem;
    color: var(--terracotta);
  }

  .hours__link {
    margin-top: 1.75rem;
  }

  .hours__card {
    position: relative;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    border-radius: var(--radius-lg);
    background: var(--cream-light);
    box-shadow: var(--shadow-soft);
  }

  .hours__card-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.25rem 1rem;
    border-bottom: 1px solid var(--line-strong);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--wood);
  }

  .hours__card-title :global(.icon) {
    color: var(--gold);
  }

  .hours__list {
    margin: 0;
  }

  .hours__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--line);
  }

  .hours__row:last-child {
    border-bottom: 0;
  }

  .hours__row dt {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    color: var(--ink);
  }

  .hours__row dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 450;
    color: var(--green);
    white-space: nowrap;
  }

  .hours__row--closed dt,
  .hours__row--closed dd {
    color: var(--ink-soft);
    font-weight: 500;
  }

  .hours__row--closed dd {
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  .hours__today {
    display: none;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--terracotta);
    color: var(--on-dark);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hours__row.is-today {
    margin-inline: -0.75rem;
    padding-inline: 1rem;
    border-radius: var(--radius);
    background: var(--cream);
  }

  .hours__row.is-today .hours__today {
    display: inline-block;
  }

  @media (max-width: 900px) {
    .hours__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { openingHours, timeZone } from '../content/hours';
  import { localTime, openingStatus, statusText } from '../lib/hours';

  // Indicador pelo horário habitual, sempre no fuso de Itaúna.
  const update = () => {
    const now = new Date();
    const { weekday } = localTime(now, timeZone);
    document.querySelectorAll<HTMLElement>('.hours__row').forEach((row) => {
      row.classList.toggle('is-today', Number(row.dataset.weekday) === weekday);
    });

    const box = document.querySelector<HTMLElement>('[data-hours-status]');
    const text = document.querySelector<HTMLElement>('[data-hours-status-text]');
    if (!box || !text) return;
    const status = openingStatus(openingHours, now, timeZone);
    const message = `${statusText(status)} (horário habitual)`;
    if (text.textContent !== message) text.textContent = message;
    box.classList.toggle('is-open', status.open);
    box.hidden = false;
  };

  update();
  setInterval(update, 60_000);
</script>
